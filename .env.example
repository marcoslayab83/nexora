APP_NAME=Nexora
APP_SLOGAN="Aquí empieza el futuro de tu negocio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nexora.centralces.pro
ASSET_URL=https://nexora.centralces.pro
APP_TIMEZONE=America/Caracas

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexora_db
DB_USERNAME=mysql
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="soporte@centralces.pro"
MAIL_FROM_NAME="${APP_NAME}"

BCV_AUTO_SYNC=true
VITE_APP_NAME="${APP_NAME}"
